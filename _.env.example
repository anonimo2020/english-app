# Copia este archivo a .env (o expórtalas en tu terminal) para probar en local.
# Nunca subas tu clave real a GitHub.

# Opción A: Groq (capa gratuita)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b

# Opción B: Gemini vía su endpoint compatible con OpenAI
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=<un modelo gratuito vigente de Google AI Studio>

AI_API_KEY=pon_tu_clave_aqui
APP_TOKEN=inventa_una_cadena_larga_y_aleatoria
RATE_LIMIT_PER_MIN=20
CORS_ORIGINS=*
